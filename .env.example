# Environment variables for Bloop
# Copy this file to .env and fill in your values

# Original bloop configuration
API_URL='required for self-serve only'
ONBOARDING='if you want to force onboarding flow'

# Real Backend API Keys (for Python backend option)
# OpenAI API Key (required for AI-enhanced search and chat)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Personal Access Token (required for repository access)
# Get from: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_TOKEN=your_github_token_here
