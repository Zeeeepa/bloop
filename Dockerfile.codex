# Dockerfile for OpenAI Codex Local Server
FROM rust:1.75 as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Codex source code
COPY codex/codex-rs ./codex-rs
COPY codex/package.json ./
COPY codex/pnpm-lock.yaml ./

# Build the Codex core and server components
WORKDIR /app/codex-rs
RUN cargo build --release --bin codex-cli

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create codex user
RUN useradd -m -u 1000 codex

# Copy built binaries
COPY --from=builder /app/codex-rs/target/release/codex-cli /usr/local/bin/codex
COPY --from=builder /app/codex-rs/core/prompt.md /app/prompt.md

# Set permissions
RUN chmod +x /usr/local/bin/codex

# Create config directory
RUN mkdir -p /home/codex/.codex && chown -R codex:codex /home/codex

# Switch to codex user
USER codex
WORKDIR /home/codex

# Expose port for API server
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Default command
CMD ["codex", "--server", "--port", "8080", "--host", "0.0.0.0"]
